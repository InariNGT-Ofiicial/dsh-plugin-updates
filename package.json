{
  "name": "dsh-plugin-updates",
  "version": "0.2.1",
  "description": "自动连接已安装 DSH 插件的原 GitHub 仓库，默认每 24 小时检查并自动更新",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js" },
  "bin": { "dsh-plugin-updates": "./bin/check.mjs" },
  "files": ["index.js", "cordis.patch.yml", "lib", "bin", "vendor", "docs", "README.md", "LICENSE", "NOTICE.md", "CHANGELOG.md"],
  "engines": { "node": ">=24.0.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "peerDependencies": { "@deepseek-ai/dsh-tools": "0.2.1-rc.2", "@deepseek-ai/schemastery": "3.18.5", "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-tools": {"optional": true}, "@deepseek-ai/schemastery": {"optional": true}, "@deepseek-ai/dsh-app-boot": {"optional": true} },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": { "test": "node --test test/*.test.mjs", "check": "node scripts/check.mjs" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/InariNGT-Ofiicial/dsh-plugin-updates.git" },
  "homepage": "https://github.com/InariNGT-Ofiicial/dsh-plugin-updates#readme",
  "bugs": { "url": "https://github.com/InariNGT-Ofiicial/dsh-plugin-updates/issues" },
  "keywords": ["dsh-plugin", "github", "updates"]
}
